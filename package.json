{
  "name": "demo-api-gateway",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*",
    "infrastructure"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "cdk:bootstrap": "npm run bootstrap --workspace @demo/infrastructure --",
    "cdk:deploy": "npm run deploy --workspace @demo/infrastructure --",
    "cdk:destroy": "npm run destroy --workspace @demo/infrastructure --",
    "cdk:diff": "npm run diff --workspace @demo/infrastructure --",
    "cdk:synth": "npm run synth --workspace @demo/infrastructure --",
    "debug": "concurrently --raw \"npm run debug:gateway\" \"npm run debug:backend\"",
    "debug:gateway": "npm run debug --workspace @demo/gateway",
    "debug:backend": "npm run debug --workspace @demo/user-api",
    "dev": "concurrently --raw \"npm run dev --workspace @demo/gateway\" \"npm run dev --workspace @demo/user-api\"",
    "dev:pretty": "npm run dev | pino-pretty --colorize --single-line",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start:gateway": "npm start --workspace @demo/gateway",
    "start:backend": "npm start --workspace @demo/user-api",
    "test": "npm test --workspaces --if-present",
    "test:cognito-token": "bash scripts/cognito/get-test-token.sh",
    "test:scenarios": "bash scripts/cognito/run-test-scenarios.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "pino-pretty": "^13.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=20"
  }
}
