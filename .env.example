# Gateway
NODE_ENV=development
LOG_LEVEL=info
# Number of reverse proxies in front of these services. Keep 0 when running locally.
TRUST_PROXY_HOPS=0
GATEWAY_PORT=3000
BACKEND_URL=http://127.0.0.1:3001

# Amazon Cognito User Pool
COGNITO_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_EXAMPLE
COGNITO_AUDIENCE=your-cognito-app-client-id

# Optional override. By default this is derived from COGNITO_ISSUER.
# COGNITO_JWKS_URI=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_EXAMPLE/.well-known/jwks.json

# User API
USER_API_PORT=3001