# Gateway
NODE_ENV=development
LOG_LEVEL=info
# Number of reverse proxies in front of these services. Keep 0 when running locally.
TRUST_PROXY_HOPS=0
GATEWAY_PORT=3000
BACKEND_URL=http://127.0.0.1:3001

# Amazon Cognito User Pool
COGNITO_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_EXAMPLE
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_HOSTED_UI_URL=https://your-domain.auth.ap-southeast-2.amazoncognito.com
COGNITO_READ_SCOPE=demo-api/users.read
COGNITO_WRITE_SCOPE=demo-api/users.write
# Values used by the PKCE test-token helper.
COGNITO_REDIRECT_URI=http://localhost:3000/callback
COGNITO_OAUTH_SCOPES=openid demo-api/users.read demo-api/users.write

# Optional override. By default this is derived from COGNITO_ISSUER.
# COGNITO_JWKS_URI=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_EXAMPLE/.well-known/jwks.json

# User API
USER_API_PORT=3001